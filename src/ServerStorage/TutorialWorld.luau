local function stone(name: string, size: Vector3, position: Vector3, color: Color3, collide: boolean, parent: Instance): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Position = position
	part.Color = color
	part.Material = Enum.Material.Concrete
	part.Anchored = true
	part.CanCollide = collide
	part.CanQuery = collide
	part.CanTouch = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part:SetAttribute("CanMetalMove", false)
	part:SetAttribute("IsMetal", false)
	part.Parent = parent
	return part
end

function TutorialWorld.Build(parent: Instance): (Model, SpawnLocation)
	assert(typeof(parent) == "Instance", "TutorialWorld.Build needs an Instance parent")
	local root = Instance.new("Model")
	root.Name = "TutorialWorld"
	root:SetAttribute("WorldType", "Tutorial")
	root:SetAttribute("AssetVersion", 1)
	local spawn: SpawnLocation? = nil
	local ok, problem = pcall(function()
		local ground = stone("Baseplate", Vector3.new(720,8,720), Vector3.new(0,-4,0), Color3.fromRGB(113,120,107), true, root)
		ground.Material = Enum.Material.Concrete
		local wall = Instance.new("Model")
		wall.Name = "MedievalStoneWall"
		wall:SetAttribute("WidthStuds", 300)
		wall:SetAttribute("HeightStuds", 100)
		wall:SetAttribute("CoreThicknessStuds", 12)
		wall.Parent = root
		local groups: {[string]: Folder} = {}
		for _, row in WALL_PARTS do
			local groupName = row[6] :: string
			if not groups[groupName] then
				local folder = Instance.new("Folder")
				folder.Name = groupName
				folder.Parent = wall
				groups[groupName] = folder
			end
			local size = row[2] :: {number}
			local pos = row[3] :: {number}
			stone(row[1] :: string, Vector3.new(size[1],size[2],size[3]), Vector3.new(pos[1],pos[2],pos[3]), PALETTE[row[4] :: number], row[5] :: boolean, groups[groupName])
		end
		local location = Instance.new("SpawnLocation")
		location.Name = "TutorialSpawn"
		location.Size = Vector3.new(8,1,8)
		location.CFrame = CFrame.lookAt(Vector3.new(0,.5,120),Vector3.new(0,.5,-80))
		location.Anchored = true
		location.Neutral = true
		location.Enabled = true
		location.Duration = 0
		location.Transparency = 1
		location.CanCollide = false
		location.CanTouch = false
		location.CanQuery = false
		location:SetAttribute("CanMetalMove", false)
		location:SetAttribute("IsMetal", false)
		location.Parent = root
		spawn = location
	end)
	if not ok then
		root:Destroy()
		error(problem)
	end
	local builtSpawn = spawn :: SpawnLocation
	local parentOK, parentProblem = pcall(function() root.Parent = parent end)
	if not parentOK then
		root:Destroy()
		error(parentProblem)
	end
	return root, builtSpawn
end

return TutorialWorld
